# === REDIRECTS (301) — must be BEFORE rewrites ===

# Duplicate pages → canonical
/kontakt  /  301

# Trailing slashes → canonical without slash
/*/  /:splat  301

# === REWRITES (200) ===

# SPA fallback for client-side routing
# Netlify serves static files first (prerendered HTML per route),
# then falls back to SPA index.html for unknown paths.
/*  /index.html  200
